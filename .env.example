# AI Director / Vercel AI Gateway
AI_GATEWAY_API_KEY=
DIRECTOR_MODEL=openai/gpt-5.5

# Video generation
GEMINI_API_KEY=
VIDEO_MODEL=veo-3.1-generate-preview

# Natural voice
VOICE_MODEL=fish-audio/s2.1-pro
VOICE_ID=

# Music + SFX
ELEVENLABS_API_KEY=
MUSIC_MODEL=music_v2
SFX_MODEL=eleven_text_to_sound_v2

# Durable persistence + media
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
REQUIRE_DURABLE_MEDIA=1

# Render orchestration
APP_URL=
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
USE_RENDER_WORKFLOW=1
ENABLE_LOCAL_RENDER=0

# Multimodal visual quality control
VISUAL_QC_MODEL=google/gemini-2.5-pro

# V23 production audio mastering defaults
AUDIO_MASTER_TARGET_LUFS=-14
AUDIO_MASTER_TRUE_PEAK_DB=-1.5
AUDIO_MASTER_LRA=11

# V27 production readiness
# Set all five in production before enabling the readiness gate.
# AI_GATEWAY_API_KEY=
# GEMINI_API_KEY=
# BLOB_READ_WRITE_TOKEN=
# DATABASE_URL=
# RENDER_WORKER_URL=
# RENDER_WORKER_SECRET=
# APP_URL=https://your-ai-film-studio-domain.example
# USE_RENDER_WORKFLOW=1
# REQUIRE_DURABLE_MEDIA=1

# V27 hardened database mode
# DB_AUTO_MIGRATE=0

# V28 operations
OPS_STATUS_SECRET=
RENDER_WORKER_MAX_CONCURRENCY=1
